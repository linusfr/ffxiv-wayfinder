<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <!-- Overridden by CI: dotnet build -p:Version=$(semantic-release output) -->
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <AssemblyName>Wayfinder</AssemblyName>
    <RootNamespace>Wayfinder</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Only the two native-invocation call sites need it; everything else is
         managed. See Integrations/DutyFinderIntegration.cs and TeleportIntegration.cs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- DalamudPackager manifest fields -->
  <PropertyGroup>
    <Author>linusfr</Author>
    <Name>Wayfinder</Name>
    <Punchline>Adds a fuzzy search box to the Duty Finder and the Teleport window.</Punchline>
    <Description>Docks a search field under the game's own Duty Finder and Teleport windows. Type part of a name — "aurum", "arum", "vale", "alex", "radz" — and pick from ranked results; the game's own window then does the selecting, queueing and teleporting exactly as if you had clicked the row yourself. Search and filter only: no automation, no queueing for you, no bypassing unlocks, level requirements or gil costs.</Description>
    <ApplicableVersion>any</ApplicableVersion>
    <DalamudApiLevel>15</DalamudApiLevel>
    <Tags>search;duty;dutyfinder;teleport;ui;utility;quality-of-life</Tags>
    <RepoUrl>https://github.com/linusfr/ffxiv-wayfinder</RepoUrl>
    <!-- DalamudPackager writes this into the shipped manifest; the installer
         fetches the image from here, so the zip does not carry it. -->
    <IconUrl>https://raw.githubusercontent.com/linusfr/ffxiv-wayfinder/main/images/icon.png</IconUrl>
  </PropertyGroup>

  <!-- Dalamud shows images/icon.png next to the DLL for local and dev installs;
       repo installs use IconUrl from the manifest. Ship both. -->
  <ItemGroup>
    <Content Include="..\images\icon.png" Link="images\icon.png"
             CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\images\icon.png')" />
  </ItemGroup>
</Project>
